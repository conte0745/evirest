{
  "app": "evirest",
  "version": 2,
  "systems": [
    {
      "id": "crm",
      "name": "顧客管理システム",
      "envs": [
        {
          "id": "local",
          "name": "ローカル",
          "baseUrl": "http://localhost",
          "port": "8080",
          "vars": [
            {
              "k": "token",
              "v": ""
            },
            {
              "k": "password",
              "v": ""
            }
          ],
          "color": "#0f766e"
        },
        {
          "id": "stg",
          "name": "検証",
          "baseUrl": "https://stg.example.com",
          "vars": [
            {
              "k": "token",
              "v": ""
            },
            {
              "k": "password",
              "v": ""
            }
          ],
          "color": "#2563eb"
        }
      ],
      "requests": [
        {
          "id": "users-list",
          "name": "ユーザー一覧（2ページ目）",
          "method": "GET",
          "url": "/tenants/${tenantId}/users?page=${page}&limit=${limit}",
          "headers": [
            {
              "k": "Accept",
              "v": "application/json"
            }
          ],
          "auth": {
            "type": "bearer",
            "token": "${token}"
          },
          "asserts": [
            {
              "target": "status",
              "op": "eq",
              "value": "200"
            },
            {
              "target": "json",
              "path": "items[0].id",
              "op": "exists"
            },
            {
              "target": "time",
              "op": "lt",
              "value": "1000"
            }
          ],
          "package": "ユーザー",
          "subpackage": "一覧",
          "batchSelected": true,
          "pathParams": [
            {
              "k": "tenantId",
              "v": "demo-tenant"
            }
          ],
          "params": [
            {
              "k": "page",
              "v": "2"
            },
            {
              "k": "limit",
              "v": "20"
            }
          ]
        },
        {
          "id": "users-create",
          "name": "ユーザー登録",
          "method": "POST",
          "url": "/users",
          "bodyType": "json",
          "body": "{\n  \"name\": \"山田太郎\",\n  \"email\": \"taro@example.com\"\n}",
          "auth": {
            "type": "bearer",
            "token": "${token}"
          },
          "asserts": [
            {
              "target": "status",
              "op": "eq",
              "value": "201"
            },
            {
              "target": "header",
              "path": "content-type",
              "op": "contains",
              "value": "application/json"
            }
          ],
          "package": "ユーザー",
          "subpackage": "登録",
          "batchSelected": false
        },
        {
          "id": "login",
          "name": "ログイン（フォーム）",
          "method": "POST",
          "url": "/login",
          "bodyType": "form",
          "form": [
            {
              "k": "username",
              "v": "taro"
            },
            {
              "k": "password",
              "v": "${password}"
            }
          ],
          "package": "認証",
          "subpackage": "",
          "batchSelected": false
        }
      ]
    }
  ]
}
